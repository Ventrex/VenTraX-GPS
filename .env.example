# VenTrax configuratie
# Kopieer naar .env en vul in. Nooit committen naar git.

# Server
DATABASE_URL=sqlite:////app/instance/venfaye.db
SECRET_KEY=verander-dit-naar-een-lange-willekeurige-string
PORT=5000

# Publieke URL voor e-maillinks en QR-codes.
BASE_URL=http://jouwdomein.nl:5001
# APP_URL=http://192.168.0.76:5001

# Mail optioneel. Laat MAIL_USERNAME leeg om mail uit te schakelen.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@ventrax.nl
