# VenTrax configuratie
# Kopieer naar .env en vul in. Nooit committen naar git.

# Server
DATABASE_URL=sqlite:////app/instance/venfaye.db
SECRET_KEY=verander-dit-naar-een-lange-willekeurige-string
PORT=5000

# Publieke URL voor e-maillinks en QR-codes.
BASE_URL=http://jouwdomein.nl:5001
# APP_URL=http://192.168.0.76:5001

# Mail optioneel. Laat MAIL_USERNAME leeg om mail uit te schakelen.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@ventrax.nl

# Cloudflare Turnstile - bot-bescherming op /register. Zie docs/CLOUDFLARE_SECURITY.md.
# Leeg laten = check staat uit (lokale dev). Gebruik in dev evt. Cloudflare's test keys:
# site key 1x00000000000000000000AA / secret key 1x0000000000000000000000000000AA (altijd geldig)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Extra CIDR's (komma-gescheiden) die je vertrouwt om CF-Connecting-IP door te geven,
# naast Cloudflare's eigen IP-ranges - alleen nodig als er een eigen reverse proxy
# tussen Cloudflare en deze app in staat. Leeg laten als dat niet het geval is.
TRUSTED_PROXY_CIDRS=
